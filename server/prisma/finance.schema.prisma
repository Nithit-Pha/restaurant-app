// ---- Expense categories -------------------------------------------------
enum ExpenseCategory {
  RENT
  LABOR
  UTILITIES
  FOOD_SUPPLY
  MARKETING
  MISCELLANEOUS
}

// ---- Expense model ------------------------------------------------------
model Expense {
  id          String          @id @default(uuid())
  amount      Decimal         @db.Decimal(10, 2) // always > 0 (enforced in app layer)
  category    ExpenseCategory
  date        DateTime        @default(now())
  description String?
  // who logged it — useful for audit
  createdBy   User?           @relation(fields: [createdById], references: [id])
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([date])
  @@index([category])
}

