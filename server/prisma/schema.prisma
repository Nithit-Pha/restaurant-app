generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  STAFF
  SUPER_ADMIN
}

enum OrderType {
  PICKUP
  DELIVERY
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH       // at pickup or on delivery
  PROMPTPAY  // the restaurant's own PromptPay QR, confirmed by staff
}

// Separate from the order status: a delivered order can still be unpaid.
enum PaymentStatus {
  UNPAID
  PENDING   // customer says they transferred; staff still have to check
  PAID
  REFUNDED
}

model User {
  id         String     @id @default(uuid())
  name       String
  // Sign-in name: 3-32 chars, a-z 0-9 . _ -, stored lowercase.
  username   String     @unique
  // Required when a customer registers; optional for staff accounts.
  email      String?    @unique
  password   String
  role       Role       @default(CUSTOMER)
  phone      String?
  address    String?
  // Deactivated accounts cannot log in; history keeps pointing at them.
  isActive     Boolean    @default(true)
  // Bumped to invalidate every token issued before (deactivate, log out everywhere).
  tokenVersion Int        @default(0)
  // Website language the user last chose: "en" or "th".
  locale     String     @default("en")
  orders     Order[]
  expenses   Expense[]
  auditLogs  AuditLog[]
  statusChanges OrderStatusHistory[]
  confirmedPayments Payment[]
  addresses  Address[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

// A customer's saved delivery address: the text for the driver and the pin
// the delivery fee is worked out from. Orders copy both, so editing or
// deleting an address never changes past orders.
model Address {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  label     String   // e.g. "Home", "Office"
  text      String   // house number, street, area
  lat       Float
  lng       Float
  note      String?  // for the driver, e.g. "blue gate, call on arrival"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model MenuItem {
  id           String      @id @default(uuid())
  name         String
  description  String?
  // Optional Thai name and description; the Thai site falls back to English.
  nameTh        String?
  descriptionTh String?
  category     String
  costPrice    Decimal     @db.Decimal(10, 2)
  sellingPrice Decimal     @db.Decimal(10, 2)
  imageUrl     String?
  isAvailable  Boolean     @default(true)
  orderItems   OrderItem[]
  modifierGroups ModifierGroup[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([category])
}

// A choice on a menu item, e.g. "Size" (pick exactly 1) or "Extras" (up to 3).
model ModifierGroup {
  id         String     @id @default(uuid())
  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  menuItemId String
  name       String
  minSelect  Int        @default(0) // 0 = optional, 1+ = required
  maxSelect  Int        @default(1)
  sortOrder  Int        @default(0)
  modifiers  Modifier[]

  @@index([menuItemId])
}

// One option in a group, e.g. "Large" (+20) or "No peanuts" (+0).
model Modifier {
  id          String        @id @default(uuid())
  group       ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId     String
  name        String
  priceDelta  Decimal       @default(0) @db.Decimal(10, 2) // added to the item price (can be negative)
  isAvailable Boolean       @default(true)
  sortOrder   Int           @default(0)
  orderItemModifiers OrderItemModifier[]

  @@index([groupId])
}

model Order {
  id              String      @id @default(uuid())
  user            User        @relation(fields: [userId], references: [id])
  userId          String
  items           OrderItem[]
  type            OrderType
  status          OrderStatus @default(PENDING)
  deliveryAddress String?
  deliveryLat     Float?
  deliveryLng     Float?
  subtotal        Decimal     @db.Decimal(10, 2)
  taxRate         Decimal     @db.Decimal(5, 4)
  taxAmount       Decimal     @db.Decimal(10, 2)
  deliveryFee     Decimal     @db.Decimal(10, 2) @default(0)
  total           Decimal     @db.Decimal(10, 2)
  totalCost       Decimal     @db.Decimal(10, 2)
  profit          Decimal     @db.Decimal(10, 2)
  // Short number per business day (#042), shown to staff and customers.
  orderNumber     Int?
  businessDate    String?     // YYYY-MM-DD in the restaurant's time zone
  // Sent by the client per checkout attempt; a retry returns the same order.
  idempotencyKey  String?     @unique
  customerPhone   String?
  acceptedAt       DateTime?
  estimatedReadyAt DateTime?
  readyAt          DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     CancelReason?
  cancelNote       String?
  cancelledById    String?
  paymentMethod   PaymentMethod @default(CASH)
  paymentStatus   PaymentStatus @default(UNPAID)
  paidAt          DateTime?
  payments        Payment[]
  statusHistory   OrderStatusHistory[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([businessDate, orderNumber])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
}

enum CancelReason {
  SOLD_OUT
  CLOSING_SOON
  TOO_BUSY
  OUT_OF_AREA
  CUSTOMER_REQUEST
  OTHER
}

// One row per status change: who moved the order, from what, to what, when.
model OrderStatusHistory {
  id         String       @id @default(uuid())
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actor      User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId    String?
  note       String?
  createdAt  DateTime     @default(now())

  @@index([orderId])
}

// Money that moved for an order: one row when it was paid, one more if it was
// refunded. A card gateway later adds rows the same way (providerRef = its id).
model Payment {
  id            String        @id @default(uuid())
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId       String
  method        PaymentMethod
  status        PaymentStatus // PAID or REFUNDED
  amount        Decimal       @db.Decimal(10, 2)
  providerRef   String?       // e.g. the bank transfer reference
  note          String?
  confirmedBy   User?         @relation(fields: [confirmedById], references: [id], onDelete: SetNull)
  confirmedById String?
  createdAt     DateTime      @default(now())

  @@index([orderId])
}

// Atomic per-day counter behind Order.orderNumber.
model DailyCounter {
  date  String @id // YYYY-MM-DD in the restaurant's time zone
  value Int    @default(0)
}

model OrderItem {
  id           String   @id @default(uuid())
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId      String
  menuItem     MenuItem @relation(fields: [menuItemId], references: [id])
  menuItemId   String
  nameSnapshot String
  unitPrice    Decimal  @db.Decimal(10, 2) // item price + chosen options
  unitCost     Decimal  @db.Decimal(10, 2)
  quantity     Int
  note         String?  // e.g. "no peanuts", for the kitchen
  modifiers    OrderItemModifier[]
}

// The options chosen on an order line, copied at order time so later menu
// edits never change past orders.
model OrderItemModifier {
  id          String    @id @default(uuid())
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  orderItemId String
  modifier    Modifier? @relation(fields: [modifierId], references: [id], onDelete: SetNull)
  modifierId  String?
  groupName   String
  name        String
  priceDelta  Decimal   @db.Decimal(10, 2)
  position    Int       @default(0) // display order

  @@index([orderItemId])
}

// Key-value store for Super Admin configurable settings
model Setting {
  key       String   @id  // e.g. "TAX_RATE", "DELIVERY_BASE_FEE", "DELIVERY_FEE_PER_KM", "DELIVERY_FREE_KM"
  value     String
  updatedAt DateTime @updatedAt
}

enum ExpenseCategory {
  RENT
  LABOR
  UTILITIES
  FOOD_SUPPLY
  MARKETING
  MISCELLANEOUS
}

model Expense {
  id          String          @id @default(uuid())
  amount      Decimal         @db.Decimal(10, 2)
  category    ExpenseCategory
  date        DateTime        @default(now())
  description String?
  createdBy   User?           @relation(fields: [createdById], references: [id])
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([date])
  @@index([category])
}

// Append-only audit trail of all privileged mutations
model AuditLog {
  id         String   @id @default(uuid())
  actor      User     @relation(fields: [actorId], references: [id])
  actorId    String
  action     String   // CREATE | UPDATE | DELETE | STATUS_CHANGE | LOGIN
  entityType String   // USER | MENU_ITEM | ORDER | EXPENSE | SETTING
  entityId   String?
  metadata   Json?    // small before/after snapshot
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType])
  @@index([createdAt])
}

// ---------------------------------------------------------------- Dine-in --
// The floor plan the owner draws: zones ("Indoor", "Terrace") with tables.
// Sizes and positions are in grid cells, so layouts always line up.

enum TableShape {
  ROUND
  SQUARE
  RECT
}

// Live state of a table on the floor view (used from Step 1c on).
enum TableStatus {
  FREE
  SEATED
  ORDERED
  SERVED
  BILL_REQUESTED
  CLEANING
}

model FloorZone {
  id        String        @id @default(uuid())
  name      String        // e.g. "Indoor", "Terrace", "2nd floor"
  sortOrder Int           @default(0)
  width     Int           // grid cells
  height    Int
  // Walls, bar, entrance, plants, kitchen door: [{ type, x, y, width, height, rotation }]
  decor     Json          @default("[]")
  tables    DiningTable[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model DiningTable {
  id        String      @id @default(uuid())
  zone      FloorZone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  zoneId    String
  label     String      // "T1", unique among active tables (checked in the service)
  shape     TableShape
  seats     Int
  x         Int         // top-left corner before rotation, grid cells
  y         Int
  width     Int
  height    Int
  rotation  Int         @default(0) // 0, 45, 90 or 135 degrees
  // Secret part of the table's QR link; a new one can be made if a sticker is copied.
  qrToken   String      @unique
  isActive  Boolean     @default(true)
  status    TableStatus @default(FREE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([zoneId])
}
