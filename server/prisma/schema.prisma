generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  STAFF
  SUPER_ADMIN
}

enum OrderType {
  PICKUP
  DELIVERY
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model User {
  id         String     @id @default(uuid())
  name       String
  email      String     @unique
  password   String
  role       Role       @default(CUSTOMER)
  phone      String?
  address    String?
  // Deactivated accounts cannot log in; history keeps pointing at them.
  isActive     Boolean    @default(true)
  // Bumped to invalidate every token issued before (deactivate, log out everywhere).
  tokenVersion Int        @default(0)
  orders     Order[]
  expenses   Expense[]
  auditLogs  AuditLog[]
  statusChanges OrderStatusHistory[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model MenuItem {
  id           String      @id @default(uuid())
  name         String
  description  String?
  category     String
  costPrice    Decimal     @db.Decimal(10, 2)
  sellingPrice Decimal     @db.Decimal(10, 2)
  imageUrl     String?
  isAvailable  Boolean     @default(true)
  orderItems   OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([category])
}

model Order {
  id              String      @id @default(uuid())
  user            User        @relation(fields: [userId], references: [id])
  userId          String
  items           OrderItem[]
  type            OrderType
  status          OrderStatus @default(PENDING)
  deliveryAddress String?
  deliveryLat     Float?
  deliveryLng     Float?
  subtotal        Decimal     @db.Decimal(10, 2)
  taxRate         Decimal     @db.Decimal(5, 4)
  taxAmount       Decimal     @db.Decimal(10, 2)
  deliveryFee     Decimal     @db.Decimal(10, 2) @default(0)
  total           Decimal     @db.Decimal(10, 2)
  totalCost       Decimal     @db.Decimal(10, 2)
  profit          Decimal     @db.Decimal(10, 2)
  // Short number per business day (#042), shown to staff and customers.
  orderNumber     Int?
  businessDate    String?     // YYYY-MM-DD in the restaurant's time zone
  // Sent by the client per checkout attempt; a retry returns the same order.
  idempotencyKey  String?     @unique
  customerPhone   String?
  acceptedAt       DateTime?
  estimatedReadyAt DateTime?
  readyAt          DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     CancelReason?
  cancelNote       String?
  cancelledById    String?
  statusHistory   OrderStatusHistory[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([businessDate, orderNumber])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
}

enum CancelReason {
  SOLD_OUT
  CLOSING_SOON
  TOO_BUSY
  OUT_OF_AREA
  CUSTOMER_REQUEST
  OTHER
}

// One row per status change: who moved the order, from what, to what, when.
model OrderStatusHistory {
  id         String       @id @default(uuid())
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actor      User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId    String?
  note       String?
  createdAt  DateTime     @default(now())

  @@index([orderId])
}

// Atomic per-day counter behind Order.orderNumber.
model DailyCounter {
  date  String @id // YYYY-MM-DD in the restaurant's time zone
  value Int    @default(0)
}

model OrderItem {
  id           String   @id @default(uuid())
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId      String
  menuItem     MenuItem @relation(fields: [menuItemId], references: [id])
  menuItemId   String
  nameSnapshot String
  unitPrice    Decimal  @db.Decimal(10, 2)
  unitCost     Decimal  @db.Decimal(10, 2)
  quantity     Int
}

// Key-value store for Super Admin configurable settings
model Setting {
  key       String   @id  // e.g. "TAX_RATE", "DELIVERY_BASE_FEE", "DELIVERY_FEE_PER_KM", "DELIVERY_FREE_KM"
  value     String
  updatedAt DateTime @updatedAt
}

enum ExpenseCategory {
  RENT
  LABOR
  UTILITIES
  FOOD_SUPPLY
  MARKETING
  MISCELLANEOUS
}

model Expense {
  id          String          @id @default(uuid())
  amount      Decimal         @db.Decimal(10, 2)
  category    ExpenseCategory
  date        DateTime        @default(now())
  description String?
  createdBy   User?           @relation(fields: [createdById], references: [id])
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([date])
  @@index([category])
}

// Append-only audit trail of all privileged mutations
model AuditLog {
  id         String   @id @default(uuid())
  actor      User     @relation(fields: [actorId], references: [id])
  actorId    String
  action     String   // CREATE | UPDATE | DELETE | STATUS_CHANGE | LOGIN
  entityType String   // USER | MENU_ITEM | ORDER | EXPENSE | SETTING
  entityId   String?
  metadata   Json?    // small before/after snapshot
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType])
  @@index([createdAt])
}
