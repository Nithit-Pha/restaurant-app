generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  STAFF
  SUPER_ADMIN
}

enum OrderType {
  PICKUP
  DELIVERY
  DINE_IN
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH       // at pickup or on delivery
  PROMPTPAY  // the restaurant's own PromptPay QR, confirmed by staff
}

// Separate from the order status: a delivered order can still be unpaid.
enum PaymentStatus {
  UNPAID
  PENDING   // customer says they transferred; staff still have to check
  PAID
  REFUNDED
}

model User {
  id         String     @id @default(uuid())
  name       String
  // Sign-in name: 3-32 chars, a-z 0-9 . _ -, stored lowercase.
  username   String     @unique
  // Required when a customer registers; optional for staff accounts.
  email      String?    @unique
  password   String
  role       Role       @default(CUSTOMER)
  phone      String?
  address    String?
  // Deactivated accounts cannot log in; history keeps pointing at them.
  isActive     Boolean    @default(true)
  // Bumped to invalidate every token issued before (deactivate, log out everywhere).
  tokenVersion Int        @default(0)
  // Website language the user last chose: "en" or "th".
  locale     String     @default("en")
  orders     Order[]
  expenses   Expense[]
  auditLogs  AuditLog[]
  statusChanges OrderStatusHistory[]
  confirmedPayments Payment[]
  addresses  Address[]
  confirmedVisits TableSession[] @relation("VisitConfirmedBy")
  stockMovements StockMovement[]
  purchaseOrdersCreated PurchaseOrder[] @relation("PoCreatedBy")
  purchaseOrdersSent    PurchaseOrder[] @relation("PoSentBy")
  deliveriesReceived    PurchaseDelivery[] @relation("DeliveryReceivedBy")
  deliveriesPriced      PurchaseDelivery[] @relation("DeliveryPricedBy")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

// A customer's saved delivery address: the text for the driver and the pin
// the delivery fee is worked out from. Orders copy both, so editing or
// deleting an address never changes past orders.
model Address {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  label     String   // e.g. "Home", "Office"
  text      String   // house number, street, area
  lat       Float
  lng       Float
  note      String?  // for the driver, e.g. "blue gate, call on arrival"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model MenuItem {
  id           String      @id @default(uuid())
  name         String
  description  String?
  // Optional Thai name and description; the Thai site falls back to English.
  nameTh        String?
  descriptionTh String?
  category     String
  costPrice    Decimal     @db.Decimal(10, 2)
  sellingPrice Decimal     @db.Decimal(10, 2)
  imageUrl     String?
  isAvailable  Boolean     @default(true)
  orderItems   OrderItem[]
  modifierGroups ModifierGroup[]
  // Ingredients one portion uses; accepting an order takes them out of stock.
  recipe       RecipeItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([category])
}

// A choice on a menu item, e.g. "Size" (pick exactly 1) or "Extras" (up to 3).
model ModifierGroup {
  id         String     @id @default(uuid())
  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  menuItemId String
  name       String
  minSelect  Int        @default(0) // 0 = optional, 1+ = required
  maxSelect  Int        @default(1)
  sortOrder  Int        @default(0)
  modifiers  Modifier[]

  @@index([menuItemId])
}

// One option in a group, e.g. "Large" (+20) or "No peanuts" (+0).
model Modifier {
  id          String        @id @default(uuid())
  group       ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId     String
  name        String
  priceDelta  Decimal       @default(0) @db.Decimal(10, 2) // added to the item price (can be negative)
  isAvailable Boolean       @default(true)
  sortOrder   Int           @default(0)
  orderItemModifiers OrderItemModifier[]

  @@index([groupId])
}

model Order {
  id              String      @id @default(uuid())
  // No customer for dine-in guests who order from the table's QR code.
  user            User?       @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId          String?
  // Dine-in: the table visit this order belongs to (one visit = one bill).
  tableSession    TableSession? @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  tableSessionId  String?
  items           OrderItem[]
  type            OrderType
  status          OrderStatus @default(PENDING)
  deliveryAddress String?
  deliveryLat     Float?
  deliveryLng     Float?
  subtotal        Decimal     @db.Decimal(10, 2)
  taxRate         Decimal     @db.Decimal(5, 4)
  taxAmount       Decimal     @db.Decimal(10, 2)
  deliveryFee     Decimal     @db.Decimal(10, 2) @default(0)
  total           Decimal     @db.Decimal(10, 2)
  totalCost       Decimal     @db.Decimal(10, 2)
  profit          Decimal     @db.Decimal(10, 2)
  // Short number per business day (#042), shown to staff and customers.
  orderNumber     Int?
  businessDate    String?     // YYYY-MM-DD in the restaurant's time zone
  // Sent by the client per checkout attempt; a retry returns the same order.
  idempotencyKey  String?     @unique
  customerPhone   String?
  acceptedAt       DateTime?
  estimatedReadyAt DateTime?
  readyAt          DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     CancelReason?
  cancelNote       String?
  cancelledById    String?
  paymentMethod   PaymentMethod @default(CASH)
  paymentStatus   PaymentStatus @default(UNPAID)
  paidAt          DateTime?
  payments        Payment[]
  // Stock: taken out when staff accepted the order, put back once if it was
  // cancelled afterwards (the SALE / SALE_RETURN movements point here).
  stockDeductedAt DateTime?
  stockReturnedAt DateTime?
  stockMovements  StockMovement[]
  statusHistory   OrderStatusHistory[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([businessDate, orderNumber])
  @@index([userId])
  @@index([tableSessionId])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
}

enum CancelReason {
  SOLD_OUT
  CLOSING_SOON
  TOO_BUSY
  OUT_OF_AREA
  CUSTOMER_REQUEST
  OTHER
}

// One row per status change: who moved the order, from what, to what, when.
model OrderStatusHistory {
  id         String       @id @default(uuid())
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actor      User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId    String?
  note       String?
  createdAt  DateTime     @default(now())

  @@index([orderId])
}

// Money that moved for an order: one row when it was paid, one more if it was
// refunded. A card gateway later adds rows the same way (providerRef = its id).
model Payment {
  id            String        @id @default(uuid())
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId       String
  method        PaymentMethod
  status        PaymentStatus // PAID or REFUNDED
  amount        Decimal       @db.Decimal(10, 2)
  providerRef   String?       // e.g. the bank transfer reference
  note          String?
  confirmedBy   User?         @relation(fields: [confirmedById], references: [id], onDelete: SetNull)
  confirmedById String?
  createdAt     DateTime      @default(now())

  @@index([orderId])
}

// Atomic per-day counter behind Order.orderNumber.
model DailyCounter {
  date  String @id // YYYY-MM-DD in the restaurant's time zone
  value Int    @default(0)
}

model OrderItem {
  id           String   @id @default(uuid())
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId      String
  menuItem     MenuItem @relation(fields: [menuItemId], references: [id])
  menuItemId   String
  nameSnapshot String
  unitPrice    Decimal  @db.Decimal(10, 2) // item price + chosen options
  unitCost     Decimal  @db.Decimal(10, 2)
  quantity     Int
  note         String?  // e.g. "no peanuts", for the kitchen
  modifiers    OrderItemModifier[]
}

// The options chosen on an order line, copied at order time so later menu
// edits never change past orders.
model OrderItemModifier {
  id          String    @id @default(uuid())
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  orderItemId String
  modifier    Modifier? @relation(fields: [modifierId], references: [id], onDelete: SetNull)
  modifierId  String?
  groupName   String
  name        String
  priceDelta  Decimal   @db.Decimal(10, 2)
  position    Int       @default(0) // display order

  @@index([orderItemId])
}

// Key-value store for Super Admin configurable settings
model Setting {
  key       String   @id  // e.g. "TAX_RATE", "DELIVERY_BASE_FEE", "DELIVERY_FEE_PER_KM", "DELIVERY_FREE_KM"
  value     String
  updatedAt DateTime @updatedAt
}

enum ExpenseCategory {
  RENT
  LABOR
  UTILITIES
  FOOD_SUPPLY
  MARKETING
  MISCELLANEOUS
}

model Expense {
  id          String          @id @default(uuid())
  amount      Decimal         @db.Decimal(10, 2)
  category    ExpenseCategory
  date        DateTime        @default(now())
  description String?
  createdBy   User?           @relation(fields: [createdById], references: [id])
  createdById String?
  // Stock in with a price creates the expense (Step 2).
  stockMovements StockMovement[]
  // A priced delivery of a purchase order (Step 3d).
  purchaseDelivery PurchaseDelivery?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([date])
  @@index([category])
}

// Append-only audit trail of all privileged mutations
model AuditLog {
  id         String   @id @default(uuid())
  actor      User     @relation(fields: [actorId], references: [id])
  actorId    String
  action     String   // CREATE | UPDATE | DELETE | STATUS_CHANGE | LOGIN
  entityType String   // USER | MENU_ITEM | ORDER | EXPENSE | SETTING
  entityId   String?
  metadata   Json?    // small before/after snapshot
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType])
  @@index([createdAt])
}

// ---------------------------------------------------------------- Dine-in --
// The floor plan the owner draws: zones ("Indoor", "Terrace") with tables.
// Sizes and positions are in grid cells, so layouts always line up.

enum TableShape {
  ROUND
  SQUARE
  RECT
}

// Live state of a table on the floor view (used from Step 1c on).
enum TableStatus {
  FREE
  SEATED
  ORDERED
  SERVED
  BILL_REQUESTED
  CLEANING
}

model FloorZone {
  id        String        @id @default(uuid())
  name      String        // e.g. "Indoor", "Terrace", "2nd floor"
  sortOrder Int           @default(0)
  width     Int           // grid cells
  height    Int
  // Walls, bar, entrance, plants, kitchen, stairs: [{ type, x, y, width, height, rotation }]
  decor     Json          @default("[]")
  tables    DiningTable[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model DiningTable {
  id        String      @id @default(uuid())
  zone      FloorZone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  zoneId    String
  label     String      // "T1", unique among active tables (checked in the service)
  shape     TableShape
  seats     Int
  x         Int         // top-left corner before rotation, grid cells
  y         Int
  width     Int
  height    Int
  rotation  Int         @default(0) // 0, 45, 90 or 135 degrees
  // Secret part of the table's QR link; a new one can be made if a sticker is copied.
  qrToken   String      @unique
  isActive  Boolean     @default(true)
  status    TableStatus @default(FREE)
  sessions  TableSession[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([zoneId])
}

// One visit at a table: from the first order (or staff seating guests) until
// the bill is paid. All orders of the visit form one bill. After payment the
// visit is closed, and the next scan of the table's QR code starts a new one.
model TableSession {
  id              String       @id @default(uuid())
  table           DiningTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  tableId         String?
  // Copied, so history keeps the names if the table or zone is removed later.
  tableLabel      String
  zoneName        String
  guests          Int?
  openedAt        DateTime     @default(now())
  // Staff confirmed the guests are really there (stops orders from a photo of the QR code).
  confirmedAt     DateTime?
  confirmedBy     User?        @relation("VisitConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  confirmedById   String?
  staffCalledAt   DateTime?
  billRequestedAt DateTime?
  closedAt        DateTime?
  // Staff merged this visit into another one (a big group at joined tables):
  // its orders moved there, and guests' keys for it lead to that visit.
  mergedIntoId    String?
  orders          Order[]

  @@index([tableId, closedAt])
}

// ------------------------------------------------------------------ Stock --
// Ingredients in the shop. Every change to a quantity is a StockMovement, so
// the history explains the number on screen.
enum StockMoveType {
  SALE         // used by an order when staff accepted it
  SALE_RETURN  // put back because that order was cancelled
  PURCHASE     // stock in
  COUNT_ADJUST // difference found when counting (also the opening stock)
  WASTE        // spoiled or dropped, with a reason
}

model Ingredient {
  id           String   @id @default(uuid())
  name         String   @unique
  unit         String   // kg, g, L, ml, pcs, pack (recipes use the same unit)
  // Can drop below 0 when the real stock was higher than the app knew; the
  // next count corrects it. Orders are never blocked by a wrong number.
  quantity     Decimal  @default(0) @db.Decimal(12, 3)
  reorderLevel Decimal  @default(0) @db.Decimal(12, 3) // "low stock" at or below this
  storage      String?  // "Fridge 1", "Freezer", "Dry store"
  // Deactivated, never deleted: the history keeps pointing at it.
  isActive     Boolean  @default(true)
  // Ordering (Step 3): who delivers it, in what packs, and the levels that
  // decide what goes on an order. reorderLevel above: put it on the next order.
  supplier       Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierId     String?
  packName       String?  // "sack", "case", "bottle"
  packSize       Decimal  @default(1) @db.Decimal(12, 3) // amount in one pack, in the ingredient's unit
  targetLevel    Decimal? @db.Decimal(12, 3) // fill up to this when ordering
  emergencyLevel Decimal? @db.Decimal(12, 3) // below this: urgent order now
  lastPackPrice  Decimal? @db.Decimal(12, 2) // THB per pack, from the last delivery
  movements    StockMovement[]
  recipeItems  RecipeItem[]
  purchaseItems PurchaseOrderItem[]
  // Step 3c: when stock first fell to the urgent level (null = not urgent).
  // An urgent draft line is added once per such drop.
  urgentSince  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([supplierId])
}

// How often a supplier gets a normal order.
enum OrderFrequency {
  DAILY
  WEEKLY       // on the chosen weekdays
  EVERY_N_DAYS // every N days, counted from startDate
  MONTHLY      // on monthDay (the last day in shorter months)
}

// Who delivers ingredients (Step 3). Switched off, never deleted.
model Supplier {
  id           String         @id @default(uuid())
  name         String         @unique
  contactName  String?
  phone        String?
  lineId       String?
  email        String?
  address      String?
  note         String?
  isActive     Boolean        @default(true)
  frequency    OrderFrequency @default(WEEKLY)
  weekdays     Int[]          // WEEKLY: 1 = Monday ... 7 = Sunday
  everyNDays   Int?
  startDate    String?        // EVERY_N_DAYS: first order day, YYYY-MM-DD (Bangkok)
  monthDay     Int?           // MONTHLY: 1-31
  // When the draft order is prepared: null = when the restaurant closes on the
  // day before the order day; "HH:MM" = at that time on the order day.
  draftTime    String?
  cutOffTime   String?        // "order before 16:00", printed on the order
  leadTimeDays Int            @default(1) // days from ordering to delivery
  minOrder     Decimal?       @db.Decimal(12, 2) // THB
  ingredients  Ingredient[]
  purchaseOrders PurchaseOrder[]
  orderDayChecks OrderDayCheck[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model StockMovement {
  id            String        @id @default(uuid())
  ingredient    Ingredient    @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  ingredientId  String
  type          StockMoveType
  change        Decimal       @db.Decimal(12, 3) // + in, - out
  quantityAfter Decimal       @db.Decimal(12, 3) // stock right after this change
  reason        String?
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId        String?
  // Stock in with a price: the Finance expense it created.
  expense       Expense?      @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  expenseId     String?
  // SALE / SALE_RETURN: the order that used (or gave back) the stock.
  order         Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId       String?
  // PURCHASE from a delivery of a purchase order (Step 3d).
  purchaseDelivery   PurchaseDelivery? @relation(fields: [purchaseDeliveryId], references: [id], onDelete: SetNull)
  purchaseDeliveryId String?
  createdAt     DateTime      @default(now())

  @@index([ingredientId, createdAt])
  @@index([createdAt])
  @@index([orderId])
}

// How much of an ingredient one portion of a menu item uses (in the
// ingredient's unit). Options ("extra egg") have no recipe yet.
model RecipeItem {
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  menuItemId   String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  ingredientId String
  amount       Decimal    @db.Decimal(12, 3)

  @@id([menuItemId, ingredientId])
  @@index([ingredientId])
}

// ---- Step 3b: purchase orders --------------------------------------------

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum PurchaseOrderSource {
  MANUAL
  SCHEDULED
  EMERGENCY
}

// An order to a supplier. Shown as PO-0001 from `number`.
model PurchaseOrder {
  id           String              @id @default(uuid())
  number       Int                 @unique @default(autoincrement())
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  supplierId   String
  status       PurchaseOrderStatus @default(DRAFT)
  source       PurchaseOrderSource @default(MANUAL)
  // Order day (YYYY-MM-DD, Bangkok) of a scheduled draft: one per supplier and day.
  orderDay     String?
  // Expected delivery (YYYY-MM-DD).
  expectedDate String?
  note         String?
  createdBy    User?               @relation("PoCreatedBy", fields: [createdById], references: [id])
  createdById  String?
  sentBy       User?               @relation("PoSentBy", fields: [sentById], references: [id])
  sentById     String?
  sentAt       DateTime?
  cancelledAt  DateTime?
  // All in, or the owner said nothing more is coming.
  receivedAt   DateTime?
  items        PurchaseOrderItem[]
  deliveries   PurchaseDelivery[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([supplierId, orderDay])
  @@index([status])
}

// One ingredient on an order. Name, unit and pack are copied, so later edits
// of the ingredient do not change a sent order.
model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchaseOrderId String
  ingredient      Ingredient    @relation(fields: [ingredientId], references: [id])
  ingredientId    String
  packs           Int
  ingredientName  String
  unit            String
  packName        String?
  packSize        Decimal       @db.Decimal(12, 3)
  deliveryLines   PurchaseDeliveryLine[]

  @@unique([purchaseOrderId, ingredientId])
  @@index([ingredientId])
}

// Step 3c: each order day of a supplier is checked once (draft made, lines
// added to an open draft, or nothing low), so removed lines do not come back.
model OrderDayCheck {
  supplier        Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId      String
  orderDay        String // YYYY-MM-DD (Bangkok)
  purchaseOrderId String?
  checkedAt       DateTime @default(now())

  @@id([supplierId, orderDay])
}

// ---- Step 3d: receiving deliveries ---------------------------------------

// One delivery of a purchase order (an order can come in several). Staff
// record what arrived; the owner adds the prices, which makes one Finance
// "Food supply" expense for the delivery.
model PurchaseDelivery {
  id              String                 @id @default(uuid())
  purchaseOrder   PurchaseOrder          @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchaseOrderId String
  receivedBy      User?                  @relation("DeliveryReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  receivedById    String?
  receivedAt      DateTime               @default(now())
  note            String?
  // Sum of the line prices, once the owner entered them.
  priceTotal      Decimal?               @db.Decimal(10, 2)
  pricedBy        User?                  @relation("DeliveryPricedBy", fields: [pricedById], references: [id], onDelete: SetNull)
  pricedById      String?
  pricedAt        DateTime?
  expense         Expense?               @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  expenseId       String?                @unique
  lines           PurchaseDeliveryLine[]
  stockMovements  StockMovement[]

  @@index([purchaseOrderId])
}

model PurchaseDeliveryLine {
  id                  String            @id @default(uuid())
  delivery            PurchaseDelivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  deliveryId          String
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String
  amount              Decimal           @db.Decimal(12, 3) // in the ingredient's unit
  price               Decimal?          @db.Decimal(10, 2) // what this line cost (THB)

  @@unique([deliveryId, purchaseOrderItemId])
}
